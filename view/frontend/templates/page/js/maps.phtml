<?php
/**
 * Copied from vendor/hyva-themes/magento2-default-theme/Magento_PageBuilder/templates/widgets/map.phtml
 * but added HyvaCsp
 *
 * @var \Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\GoogleMapsApi;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelRegistry $viewModels */

$googleMapsApi = $viewModels->require(GoogleMapsApi::class);
?>
    <script>
        'use strict';

        (() => {
            const initMaps = async (elements) => {

                const {Map, MapTypeControlStyle, InfoWindow} = await google.maps.importLibrary("maps");

                const renderMap = (element) => {
                    const dataLocations = element.dataset.locations;
                    let selectedOptionCode = element.dataset.selected;

                    // Hide map if no locations set
                    if (!dataLocations || dataLocations === '[]') {
                        element.classList.add('hidden');
                        return;
                    }

                    const map = new Map(
                        element,
                        getMapOptions(
                            element.dataset.showControls !== 'true',
                            element.dataset.showControls === 'true'
                        )
                    );
                    const locations = JSON.parse(dataLocations);
                    const latitudeLongitudeBounds = new google.maps.LatLngBounds();
                    const bounds = [];

                    const infowindow = new InfoWindow();

                    locations.forEach(location => {
                        const position = {
                            lat: parseFloat(location.position.latitude),
                            lng: parseFloat(location.position.longitude),
                        };
                        bounds.push(position);


                        // Create Maps marker
                        const marker = new google.maps.marker.AdvancedMarkerElement({
                            gmpClickable: true,
                            position: position,
                            map: map,
                            title: location.location_name,
                            content: getMarkerIcon(location, selectedOptionCode),
                        });

                        marker.addListener('gmp-click', () => {
                            infowindow.setContent(getInfoWindowContent(location))
                            infowindow.open(map, marker);
                        });
                    });

                    // Set bounds if multiple locations
                    if (bounds.length > 1) {
                        bounds.forEach(function (bound) {
                            latitudeLongitudeBounds.extend(bound);
                        });
                        map.fitBounds(latitudeLongitudeBounds);
                    }

                    // Center if single location
                    if (bounds.length === 1) {
                        map.setCenter(bounds[0]);
                    }
                };

                const getMapOptions = (disableDefaultUI, mapTypeControl) => {
                    const style = '<?= $escaper->escapeJs($googleMapsApi->getStyle()) ?>';
                    return {
                        zoom: 8,
                        scrollwheel: false,
                        disableDoubleClickZoom: false,
                        mapTypeControlOptions: {
                            style: MapTypeControlStyle.DEFAULT,
                        },
                        disableDefaultUI: disableDefaultUI,
                        mapTypeControl: mapTypeControl,
                        mapId: "<?= \Monta\Hyva\Magewire\Checkout\Shipping\Pickup::MAP_IDENTIFIER?>",
                    };
                };

                /** HTML for Marker info window
                 *
                 * @param location
                 * @returns string
                 */
                const getInfoWindowContent = (location) => {
                    return `
                        <div class="max-w-xs p-4 bg-white rounded-lg shadow-md">
                          ${location.company ? `<h3 class="text-l font-semibold text-gray-900 mb-2">${location.company}</h3>` : ''}
                          ${location.displayName ? `<p class="text-gray-700 mb-2">${location.displayName}</p>` : ''}
                          ${location.addressRemark ? `<p class="text-gray-700 mb-2">${location.addressRemark}</p>` : ''}
                          ${location.phone ? `<p class="text-gray-600 mb-2"><strong>Phone:</strong> ${location.phone}</p>` : ''}
                          <address class="not-italic text-gray-600 text-sm">
                            ${location.street ? `${location.street} ${location.houseNumber}<br>` : ''}
                            ${location.city ? `${location.city}, ` : ''}
                            ${location.state ? `${location.state} ` : ''}
                            ${location.postalCode ? `${location.postalCode}<br>` : ''}
                            ${location.country ? location.country : ''}
                          </address>
                        </div>
                      `;
                };

                /** Map icon for Pickup location
                 *
                 * @param pickup
                 * @param selectedOptionCode - the selected option, to highlight on the map
                 * @returns {Element|null}
                 */
                const getMarkerIcon = (pickup, selectedOptionCode) => {
                    let markerContent = null;
                    // If Pickup location has an image, use it as icon
                    if (pickup.imageUrl) {
                        // Create container div
                        markerContent = document.createElement('div');
                        markerContent.className = 'w-10 rounded-full overflow-hidden';

                        // If this is the selected Pickup, add a blue ring
                        if (selectedOptionCode == pickup.code) {
                            // TODO very similar to 'monta-blue-focus' utility but this is not a tile
                            markerContent.className += ' ring-3 ring-blue-500';
                        }

                        // Create image inside
                        const img = document.createElement('img');
                        img.src = pickup.imageUrl;
                        img.alt = pickup.location_name || '';
                        img.className = 'w-full h-full object-cover';

                        markerContent.appendChild(img);
                    }
                    return markerContent;
                };

                const hideAllMaps = () => {
                    document.querySelectorAll('[data-content-type="map"]').forEach(element => {
                        element.classList.add('hidden');
                    });
                };

                window.gm_authFailure = () => {
                    hideAllMaps();
                };

                if (typeof google.maps === 'undefined') {
                    hideAllMaps();
                    return;
                }

                elements.forEach(element => {
                    if (element.dataset.contentType === 'map') {
                        renderMap(element);
                    }
                });
            };

            window.addEventListener('DOMContentLoaded', () => {
                // Load google Maps widget script
                const mapElements = document.querySelectorAll('#<?= \Monta\Hyva\Magewire\Checkout\Shipping\Pickup::MAP_IDENTIFIER ?>');

                if (mapElements.length > 0) {
                    const script = document.createElement('script');
                    script.type = 'text/javascript';

                    script.src = '<?= $escaper->escapeJs($googleMapsApi->getLibraryUrl()) ?>&loading=async&callback=startGoogleMapsLibrary';

                    window.startGoogleMapsLibrary = () => initMaps(mapElements);
                    document.head.appendChild(script);
                }

                // Component throws this event when Pickups tab is opened
                window.addEventListener('<?= \Monta\Hyva\Magewire\Checkout\Shipping\Pickup::INIT_MAP_EVENT?>', () => {
                    // Run Maps initializer again now that data is present
                    window.startGoogleMapsLibrary();
                });
            });
        })();
    </script>
<?php
$hyvaCsp->registerInlineScript(); ?>