<div
        id="block-shipping-options"
        class="max-w-lg mx-auto"
        x-data="montaCheckout"
        x-show="isSelected"
        x-cloak
>
    <!-- Buttons -->
    <div class="flex mx-auto mb-5">
        <!-- Render only active tab as per original KO (single visible button) -->
        <template x-for="tabButton in tabButtons" :key="tabButton.id">
            <button type="button"
                    class="button action w-1/2 py-2 text-white mx-auto"
                    :id="tabButton.id"
                    x-show="tabButton.active"
                    x-text="tabButton.label"
                    @click="clickTab(tabButton)">
            </button>
        </template>
    </div>

    <div clas="tabs">
        <!-- Delivery Options -->
        <div class="tabcontent hidden" :class="deliveryOptionsIdentifier" x-show="DeliveryOptions.length">
            <div class="flex max-w-md mx-auto justify-center gap-5 mb-5">
                <template x-for="option in DeliveryOptions" :key="option.date">
                    <!-- $this becomes each element, $parent becomes the current component -->
                    <div
                            :class="dayButtonIdentifier + ' flex-col text-center rounded-tile monta-gray-tile hover:monta-blue-focus'"
                            @click="clickDayTile(option, $event)"
                    >
                        <p class="font-semibold py-2" x-text="option.day"></p>
                        <p class="text-sm text-gray-500" x-text="option.dateFormatted"></p>
                    </div>
                </template>
            </div>

            <div>
                <template x-for="deliveryOption in SelectedDateOptions" :key="deliveryOption.code">
                    <div
                            :class="shippingOptionIdentifier + ' rounded-tile monta-gray-tile mb-5 max-w-lg mx-auto'"
                            @click="clickDeliveryOption(deliveryOption, $event)"
                    >
                        <!-- delivery.html port -->
                        <div class="flex-col">
                            <div class="flex justify-between space-x-2">
                                <div class="flex">
                                    <img :src="deliveryOption.imageUrl" class="w-16 h-16 pr-2"/>
                                    <div>
                                        <p class="font-semibold" x-text="deliveryOption.shipper"></p>
                                        <p class="text-sm text-gray-600" x-text="deliveryOption.displayNameShort"></p>
                                    </div>
                                </div>
                                <p class="text-md font-medium" x-text="deliveryOption.priceFormatted"></p>
                            </div>
                            <!-- ShipperOptions -->
                            <div class="shipperoptions" x-show="(deliveryOption.deliveryOptions ?? []).length">
                                <p class="font-semibold mb-2">Extra shipperoptions:</p>
                                <div class="space-y-2">
                                    <template x-for="shipperOption in (deliveryOption.deliveryOptions || [])"
                                              :key="shipperOption.code">
                                        <!-- TODO border color should match tile border color -->
                                        <label class="flex justify-between rounded-tile p-2 monta-gray-tile hover:monta-blue-focus">
                                            <div class="items-center space-x-2">
                                                <input type="checkbox"
                                                       :name="shipperOption.code"
                                                       @click.stop="clickShipperOption(shipperOption, $event)"
                                                />
                                                <span x-text="shipperOption.description"></span>
                                            </div>
                                            <span class="text-md" x-text="'+' + shipperOption.priceFormatted"></span>
                                        </label>
                                    </template>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        <!-- Pickup Options -->
        <div class="tabcontent hidden space-y-3" :class="pickupOptionsIdentifier">
            <!-- Attach map to this element-->
            <div class="relative w-full bg-gray-200 overflow-hidden rounded-b-md hidden">
                <div :id="mapIdentifier" class="w-full h-[250px] bg-gray-100"></div>
            </div>
            <!-- List of PickupOptions -->
            <div class="space-y-3" :id="pickupsIdentifier">
                <template x-for="pickup in PickupOptions" :key="pickup.code">
                    <div class="rounded-tile monta-gray-tile w-full"
                         @click="clickDeliveryOption(pickup, $event)">
                        <!-- pickup.html port -->
                        <div class="pickup-option flex-col">
                            <div class="pickup-header flex justify-between space-x-2">
                                <div class="flex">
                                    <img :src="pickup.imageUrl" class="pickup-logo w-16 h-16 pr-2">
                                    <div class="pickup-container">
                                        <strong x-text="pickup.company"></strong>
                                        <p class="text-sm text-gray-500" x-text="pickup.displayName"></p>
                                        <p class="text-sm text-gray-600"
                                           x-text="pickup.formattedAddress || (pickup.street + ' ' + pickup.houseNumber)"></p>
                                    </div>
                                </div>
                                <p class="text-green font-medium" x-text="pickup.priceFormatted"></p>
                            </div>
                            <div class="business-hours text-sm text-gray-500 mt-2 hidden"
                                 x-show="(pickup.openingTimes||[]).length">
                                <template x-for="slot in (pickup.openingTimes||[])"
                                          :key="slot.day + slot.from + slot.to">
                                    <p class="text-sm" x-text="slot.day + ':\t ' + slot.from + ' - ' + slot.to"></p>
                                </template>
                            </div>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Button to switch map or list -->
            <div class="text-center text-blue-500">

                <!-- When in Maps mode -->
                <div x-show="showingMap" class="flex items-center justify-between mb-4">
                    <p @click="prevPickup">&larr;</p>
                    <div>
                        <p class="text-gray-500" x-text="listButtonText"></p>
                        <span>&equiv; </span><span @click="toggleMap">List</span>
                    </div>
                    <p @click="nextPickup">&rarr;</p>
                </div>

                <!-- When in List mode-->
                <div x-else @click="toggleMap">
                    <span>&#128205; </span><span>Map</span>
                </div>
            </div>
        </div>
    </div>
</div>