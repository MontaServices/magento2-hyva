<?php

/** Template for both Pickup and StoreCollect components
 *
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Monta\Hyva\Magewire\Checkout\Shipping\Pickup|\Monta\Hyva\Magewire\Checkout\Shipping\Collect $magewire - Both components use this template
 */
?>
<div class="tabcontent <?= $magewire->tabActive ? '' : 'hidden' ?> space-y-3 tab-<?= $magewire::IDENTIFIER ?>">
    <?php
    if ($magewire->showingMap): ?>
        <!-- Attach map to this element-->
        <div class="relative w-full bg-gray-200 overflow-hidden rounded-b-md">
            <!-- TODO this little 'data-content-type' attribute causes Hyva to load map.phtml with CSP warnings but something runs🤔-->
            <div id="<?= $escaper->escapeHtmlAttr($magewire::MAP_IDENTIFIER) ?>"
                 data-content-type="map"
                 data-locations='<?= $escaper->escapeHtmlAttr(json_encode($magewire->getPickupOptions())) ?>'
                 data-show-controls="true"
                 class="w-full h-[250px] bg-gray-100"></div>
        </div>
    <?php
    endif; ?>
    <div class="<?= $magewire->showingMap ? '' : 'space-y-2' ?>">
        <?php
        foreach ($magewire->getPickupOptions() as $pickup): ?>
            <label class="flex">
                <div class="rounded-tile monta-gray-tile w-full <?=
                $escaper->escapeHtmlAttr(implode(separator: " ", array: $magewire->getClasses($pickup->getCode()))) ?>">
                    <input type="radio" class="form-radio hidden" wire:model="selectedOptionCode"
                           value="<?= $escaper->escapeHtmlAttr($pickup->getCode()) ?>"/>
                    <div class="flex-col">
                        <div class="flex justify-between space-x-2">
                            <div class="flex">
                                <?php
                                if ($imageUrl = $pickup->getImageUrl()): ?>
                                    <img src="<?= $escaper->escapeHtmlAttr($imageUrl) ?>"
                                         alt="<?= $escaper->escapeHtmlAttr($pickup->getDisplayName()); ?>"
                                         class="pickup-logo w-16 h-16 pr-2">
                                <?php
                                endif; ?>
                                <div class="pickup-container">
                                    <strong><?= $pickup->getCompany() ?></strong>
                                    <p class="text-sm text-gray-500"><?= $escaper->escapeHtml($pickup->getDisplayName()) ?></p>
                                    <p class="text-sm text-gray-600"><?= $escaper->escapeHtml($pickup->formattedAddress ?? $pickup->street . " " . $pickup->houseNumber) ?></p>
                                </div>
                            </div>
                            <p class="text-green font-medium"><?= $escaper->escapeHtml($pickup->priceFormatted) ?></p>
                        </div>
                        <?php
                        if ($magewire->isSelected($pickup->getCode())): ?>
                            <?php
                            if ($pickup->isPackstation()): ?>
                                <div>
                                    <span class="normal"><?= $escaper->escapeHtml(__("Post number")) ?></span>
                                    <input type="text" wire:model.debounce.500ms="packstationPostnumber">
                                </div>
                            <?php
                            endif; ?>
                            <?php
                            if ($openingTimes = $pickup->getOpeningTimes()): ?>
                                <div class="business-hours text-sm text-gray-500 mt-2">
                                    <?php
                                    foreach ($openingTimes as $slot): ?>
                                        <p class="text-sm flex">
                                            <span class="w-32 shrink-0"><?= $escaper->escapeHtml($slot->getDay()) ?>:</span>
                                            <span><?= $escaper->escapeHtml($slot->getFrom() . " - " . $slot->getTo()) ?></span>
                                        </p>
                                    <?php
                                    endforeach; ?>
                                </div>
                            <?php
                            endif; ?>
                        <?php
                        endif; ?>
                    </div>
                </div>
            </label>
        <?php
        endforeach; ?>
    </div>

    <!-- Button to switch map or list -->
    <?php
    if (sizeof($magewire->options) > 1): ?>
        <div class="text-center text-blue-500">
            <!-- When in List mode-->
            <?php
            if ($magewire->showingMap): ?>
                <!-- When in Maps mode -->
                <div class="flex items-center justify-between mb-4">
                    <p wire:click="prevPickup" class="<?= $magewire->prevPickup(dry: true) ? '' : 'invisible' ?>">
                        &larr;</p>
                    <div>
                        <p class="text-gray-500"><?= $escaper->escapeHtml(
                                __('%1 of %2 pickup points',
                                    $magewire->selectedPickupKey + 1, // index plus one is the readable nth counter
                                    count($magewire->options),
                                )) ?></p>
                        <span>&equiv; </span>
                        <span wire:click="toggleMap"><?= $escaper->escapeHtml(__('List')); ?></span>
                    </div>
                    <p wire:click="nextPickup" class="<?= $magewire->nextPickup(dry: true) ? '' : 'invisible' ?>">
                        &rarr;</p>
                </div>

            <?php
            else: ?>
                <div wire:click="toggleMap">
                    <span>&#128205; </span><span><?= $escaper->escapeHtml(__('Map')); ?></span>
                </div>
            <?php
            endif; ?>
        </div>
    <?php
    endif; ?>
</div>