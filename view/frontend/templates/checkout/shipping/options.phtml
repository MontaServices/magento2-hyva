<?php
/**
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Monta\Hyva\Magewire\Checkout\Shipping\Options $magewire
 * @var \Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp
 */
?>

<div id="block-shipping-options" class="w-full mt-6 max-w-full overflow-hidden"
     style="contain: inline-size;">
    <?php
    if ($magewire->show): ?>
        <!-- Buttons-->
        <div class="flex mx-auto mb-5">
            <?php
            foreach ($magewire->getTabButtons() as $tabId => $label): ?>
                <?php
                $isActive = ($magewire->mode == $tabId); ?>
                <label for="<?= $escaper->escapeHtmlAttr($tabId) ?>"
                       class="w-1/2 text-center rounded-tile transition font-semibold py-4 transition <?=
                       $isActive ? 'bg-blue-500 text-white' : 'monta-gray-tile hover:monta-blue-focus' ?>">
                    <input type="radio" class="hidden" name="shipping-mode"
                           id="<?= $escaper->escapeHtmlAttr($tabId) ?>"
                           wire:model="mode" value="<?= $escaper->escapeHtmlAttr($tabId) ?>"
                    /><?= $escaper->escapeHtml($label) ?>
                </label>
            <?php
            endforeach; ?>
        </div>
        <div class="tabs w-full min-w-0">
            <!-- Delivery Options -->
            <?php
            if (sizeof($magewire->getDeliveryOptions())): ?>
                <div class="tabcontent <?= $magewire->mode == $magewire::DELIVERY_OPTIONS_IDENTIFIER ? '' : 'hidden' ?> tab-<?= $magewire::DELIVERY_OPTIONS_IDENTIFIER ?>">
                    <!-- Day buttons -->
                    <div class="flex overflow-x-auto gap-2 mb-5 click-first <?=
                    // Hide Day buttons if there is only one
                    $magewire->isFallbackShippper() ? 'hidden' : '' ?>">
                        <?php
                        foreach ($magewire->getDeliveryOptions() as $option): ?>
                            <label class="selectDayButton flex-col text-center rounded-tile monta-gray-tile hover:monta-blue-focus py-4 px-2 transition-all <?=
                            $magewire->selectedTimeFrameDate == $option->getDate() ? 'monta-blue-focus' : '' ?>">
                                <input type="radio" wire:model="selectedTimeFrameDate" class="form-radio hidden"
                                       value="<?= $escaper->escapeHtmlAttr($option->getDate()) ?>"/>
                                <p class="font-semibold"><?= $option->getDay() ?></p>
                                <p class="text-sm text-gray-500"><?= $option->getDateFormatted() ?></p>
                            </label>
                        <?php
                        endforeach; ?>
                    </div>
                    <!-- Selected day options -->
                    <?= $block->getChildBlock('monta.hyva.shipping.method.component.delivery')->toHtml(); ?>
                </div>
            <?php
            endif; ?>
            <!-- Pickup Options (entire tab is inside childblock, unlike regular module -->
            <?php
            if (sizeof($magewire->pickupOptions)): ?>
                <?= $block->getChildBlock('monta.hyva.shipping.method.component.pickup')->toHtml() ?>
            <?php
            endif; ?>
        </div>
    <?php
    endif; ?>
</div>