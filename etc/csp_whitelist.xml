<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp/etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <!-- TODO this basically disables CSP entirely and allows XSS, not a clean solution -->
                <value id="host-unsafe-eval" type="host">'unsafe-eval'</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>