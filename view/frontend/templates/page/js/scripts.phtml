    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Select all tab Buttons
            document.querySelectorAll('.options-tab-button').forEach(btn => {
                btn.addEventListener('click', (event) => {
                    // Use existing JS for 'hide siblings'
                    window.sharedUtils.clickMode(btn.id, event);
                    // Run Magewire callback directly on Options component
                    Magewire.find("monta.hyva.shipping.method.options")
                        .call('clickMode', btn.id);

                });
            });

            /**
             * Define Alpine component on each shipper option
             */
            Alpine.data('deliveryExtras', () => ({
                    optionId: null,
                    extras: [],

                    init() {
                        this.optionId = this.$el.dataset.optionId

                        // When Shipping step was completed
                        // TODO this cannot work because of race conditions. Magewire component needs time, and could throw Exception. Parallel the user continued to Payment, which will show incorrect Shipping Total
                        window.addEventListener('checkout:validation:success', (event) => {
                            // If the Shipping step is validated succesfully
                            if (event.detail.step === 'shipping') {
                                // Sync with backend
                                let parentComponent = Magewire.find('monta.hyva.shipping.method.component.delivery');
                                if (parentComponent && parentComponent.get('selectedOptionCode') === this.optionId) {
                                    parentComponent.call('updateExtras', this.optionId, this.extras)
                                } else {
                                    console.warn("Could not find Delivery component!");

                                }
                            }
                        })
                    },

                    updateSelection() {
                        const checkbox = this.$event.target;
                        if (checkbox.checked && !this.extras.includes(checkbox.value)) {
                            this.extras.push(checkbox.value);
                        }
                        if (!checkbox.checked && this.extras.includes(checkbox.value)) {
                            this.extras.splice(this.extras.indexOf(checkbox.value), 1);
                        }
                    },

                    isChecked() {
                        return this.extras.includes(this.$el.value);
                    },
                })
            )
            // Bind clickFirst to those elements
            document.querySelectorAll('.click-first').forEach(element => {
                window.sharedUtils.clickFirst(element);
            });

            // Component throws this event when Pickups tab is opened
            // TODO move to maps.phtml
            window.addEventListener('<?= \Monta\Hyva\Magewire\Checkout\Shipping\Pickup::INIT_MAP_EVENT?>', () => {
                // Run Maps initializer again now that data is present
                window.initGoogleMapsLibrary();
            });
        });
    </script><?php
$hyvaCsp->registerInlineScript() ?>