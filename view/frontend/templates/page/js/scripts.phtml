    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Select all tab Buttons
            document.querySelectorAll('.options-tab-button').forEach(btn => {
                btn.addEventListener('click', (event) => {
                    window.sharedUtils.clickMode(btn.id, event);
                });
            });
        });
