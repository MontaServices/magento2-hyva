<?php
/**
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Monta\Hyva\Magewire\Checkout\Shipping\Options $magewire
 */
?>

<div id="block-shipping-options" class="max-w-lg mx-auto">
    <?php
    if ($magewire->show): ?>
        <!-- Buttons-->
        <!--TODO afterRender:clickFirst-->
        <div class="flex mx-auto mb-5">
            <?php
            foreach ($magewire->getTabButtons() as $button): ?>
                <!-- TODO for some reason Tailwind doesn't work on button element -->
                <!--TODO if="tabButton.active"-->
                <button type="button" id="<?= $button['id'] ?>"
                        class="button btn action w-1/2 py-2 text-white mx-auto"><?= $button['label'] ?>
                </button>
            <?php
            endforeach; ?>
        </div>
        <div class="tabs">
            <!-- Delivery Options -->
            <?php
            if (sizeof($magewire->deliveryOptions)): ?>
                <!-- TODO start all tabs as 'hidden' -->
                <div class="tabcontent tab-<?= $magewire::DELIVERY_OPTIONS_IDENTIFIER ?>">
                    <!-- Day buttons TODO afterRender: clickFirst-->
                    <div class="flex max-w-md mx-auto justify-center gap-5 mb-5">
                        <?php
                        foreach ($magewire->deliveryOptions as $option): ?>
                            <!--TODO onClick: clickDayTile -->
                            <div class="selectDayButton flex-col text-center rounded-tile monta-gray-tile hover:monta-blue-focus">
                                <p class="font-semibold py-2"><?= $option->day ?></p>
                                <p class="text-sm text-gray-500"><?= $option->dateFormatted ?></p>
                            </div>
                        <?php
                        endforeach; ?>
                    </div>
                    <!-- Selected day options -->
                    <!-- TODO afterRender: clickFirst -->
                    <!--TODO onClick:clickDeliveryOption-->
                    <?= $block->getChildBlock('monta.hyva.shipping.method.component.delivery')
                        ->setData(
                            \Monta\Hyva\Magewire\Checkout\Shipping\Delivery::OPTIONS_COLLECTION,
                            $magewire->selectedDateOptions
                        )
                        ->toHtml() ?>

                </div>
            <?php
            endif; ?>
            <!-- Pickup Options -->
            <?php
            if (sizeof($magewire->pickupOptions)): ?>
                <div class="tabcontent space-y-3 tab-<?= $magewire::PICKUP_OPTIONS_IDENTIFIER ?>">
                    <!-- Attach map to this element-->
                    <div class="relative w-full bg-gray-200 overflow-hidden rounded-b-md hidden">
                        <div id="montaPickupsMap" class="w-full h-[250px] bg-gray-100"></div>
                    </div>
                    <!-- List of PickupOptions -->
                    <?=
                    $block->getChildBlock('monta.hyva.shipping.method.component.pickup')
                        ->setData(
                            \Monta\Hyva\Magewire\Checkout\Shipping\Pickup::OPTIONS_COLLECTION,
                            $magewire->pickupOptions
                        )
                        ->toHtml() ?>

                    <!-- Button to switch map or list -->
                    <div class="text-center text-blue-500">
                        <!-- When in List mode-->
                        <?php
                        if ($magewire->showingMap): ?>
                            <!-- When in Maps mode -->
                            <div class="flex items-center justify-between mb-4">
                                <p>&larr;</p><!-- TODO onclick prevPickup-->
                                <div>
                                    <p class="text-gray-500"><?= $magewire->listButtonText() ?></p>
                                    <span>&equiv; </span>
                                    <!-- TODO onclick toggleMap -->
                                    <span><?= __('List'); ?></span>
                                </div>
                                <p>&rarr;</p><!-- TODO onclick nextPickup-->
                            </div>
                        <?php
                        else: ?>
                            <!-- TODO onclick toggleMap-->
                            <div>
                                <span>&#128205; </span><span><?= __('Map'); ?></span>
                            </div>
                        <?php
                        endif; ?>
                    </div>
                </div>
            <?php
            endif; ?>
        </div>
    <?php
    endif; ?>
</div>