<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
>
    <head>
        <script src="Monta_Hyva::js/monta-checkout.js"/>
    </head>
    <body>
        <referenceContainer name="checkout.shipping.methods.after">
            <block name="hyva.checkout.init-delivery-dates"
                   template="Monta_Hyva::shipping.phtml">
                <arguments>
                    <argument name="csp_whitelist" xsi:type="boolean">true</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>