<?php
/**
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Monta\Hyva\Magewire\Checkout\Shipping\Delivery $magewire
 */
$formatTime = static function (?string $time): ?string {
    if (!$time) {
        return null;
    }

    if (preg_match('/^\d{2}:\d{2}(?::\d{2})?$/', $time)) {
        return substr($time, 0, 5);
    }

    if (preg_match('/^\d{4}$/', $time)) {
        return substr($time, 0, 2) . ':' . substr($time, 2, 2);
    }

    return $time;
};
$formatPrice = static function (?float $price, ?string $priceFormatted) use ($escaper): string {
    if ($price !== null && abs($price) < 0.00001) {
        return $escaper->escapeHtml(__('Free'));
    }

    return $escaper->escapeHtml($priceFormatted ?? '');
};
$selectedDateOptions = $magewire->getSelectedDateOptions();
$deliveryDebug = array_map(static function ($deliveryOption): array {
    return [
        'code' => $deliveryOption->getCode(),
        'shipper' => $deliveryOption->shipper,
        'display_name_short' => $deliveryOption->displayNameShort,
        'date' => $deliveryOption->getDesiredDeliveryDate(),
        'shipper_option_codes' => array_map(
            static fn($shipperOption) => $shipperOption->getCode(),
            $deliveryOption->getShipperOptions(),
        ),
    ];
}, $selectedDateOptions);
?>
<div class="space-y-3" data-monta-delivery-debug="<?= $escaper->escapeHtmlAttr(json_encode([
    'selected_option_code' => $magewire->selectedOptionCode,
    'selected_shipper_options' => $magewire->selectedShipperOptions,
    'visible_delivery_options' => $deliveryDebug,
])) ?>">
    <?php
    // TODO class 'click-first' but not yet loaded then
    foreach ($selectedDateOptions as $deliveryOption): ?>
        <?php
        $isSelected = $magewire->isSelected($deliveryOption->getCode());
        $from = $formatTime($deliveryOption->getFrom());
        $to = $formatTime($deliveryOption->getTo());
        $hasTimeRange = $from && $to && !($from === '00:00' && $to === '00:00');
        $deliveryLine = $hasTimeRange
            ? __('Delivered between %1 and %2', $from, $to)
            : $deliveryOption->displayNameShort;
        $title = $deliveryOption->displayNameShort ?: $deliveryOption->getDisplayName();
        ?>
        <label class="block cursor-pointer">
            <div class="selectShippingOption monta-option-card <?=
            // conditionally add focus class to the selected option (similar to `focusSelection()`)
            $isSelected ? 'monta-option-card-selected' : 'hover:border-slate-400'; ?>">
                <input type="radio" class="hidden" wire:model="selectedOptionCode"
                       value="<?= $escaper->escapeHtmlAttr($deliveryOption->getCode()) ?>"/>
                <div class="space-y-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex min-w-0 items-start gap-3 sm:gap-4">
                            <?php
                            if ($imageUrl = $deliveryOption->getImageUrl()): ?>
                                <img src="<?= $escaper->escapeHtmlAttr($imageUrl) ?>"
                                      alt="<?= $escaper->escapeHtmlAttr($deliveryOption->getDisplayName()) ?>"
                                      class="h-11 w-11 shrink-0 rounded-xl border border-slate-200 bg-white object-contain p-1.5 sm:h-12 sm:w-12"/>
                            <?php
                            endif; ?>
                            <div class="flex min-h-[3rem] min-w-0 flex-col justify-center space-y-1">
                                <p class="text-[1.05rem] font-semibold leading-6 text-slate-900">
                                    <?= $escaper->escapeHtml($title) ?>
                                </p>
                                <p class="text-sm leading-5 text-slate-700 sm:text-base">
                                    <?= $escaper->escapeHtml($deliveryLine) ?>
                                </p>
                            </div>
                        </div>
                        <div class="shrink-0 pt-1 text-right sm:min-w-[5rem]">
                            <p class="text-base font-semibold text-slate-900"><?php
                                echo $formatPrice($deliveryOption->getPrice(), $deliveryOption->priceFormatted);
                            ?></p>
                        </div>
                    </div>
                    <!-- ShipperOptions -->
                    <?php
                    if ($deliveryOption->getShipperOptions()): ?>
                        <div class="shipperoptions space-y-3 border-t border-slate-200 pt-3">
                            <div class="mb-1 flex items-center justify-between gap-3">
                                <p class="text-base font-semibold text-slate-900">
                                    <?= $escaper->escapeHtml(__("Extra shipperoptions")) ?>
                                </p>
                                <span class="text-sm text-slate-400"><?= $escaper->escapeHtml(__('Optional')) ?></span>
                            </div>
                            <div class="space-y-2.5">
                                <?php
                                foreach ($deliveryOption->getShipperOptions() as $shipperOption): ?>
                                    <!-- TODO nested <label> elements is not valid HTML. Works in browser but might cause problems in JS -->
                                    <label class="monta-suboption-row <?=
                                     // if shipperoption is selected, show focus. `checked:monta-blue-focus` does not work on label
                                     (!empty($magewire->selectedShipperOptions[$deliveryOption->getCode()][$shipperOption->getCode()]) ? 'monta-suboption-row-selected' : 'hover:border-slate-300') ?>">
                                        <div class="flex min-w-0 items-center gap-3">
                                            <input type="checkbox"
                                                   class="h-5 w-5 rounded-full border-2 border-sky-400 text-sky-500 focus:ring-sky-500"
                                                   wire:model.debounce.500ms="selectedShipperOptions.<?= $escaper->escapeHtmlAttr($deliveryOption->getCode() . "." . $shipperOption->getCode()) ?>"/>
                                            <span class="text-base text-slate-800"><?= $escaper->escapeHtml($shipperOption->description) ?></span>
                                        </div>
                                        <span class="shrink-0 text-base font-semibold text-slate-900">+ <?= $escaper->escapeHtml($shipperOption->priceFormatted) ?></span>
                                    </label>
                                <?php
                                endforeach; ?>
                            </div>
                        </div>
                    <?php
                    endif; ?>
                </div>
            </div>
        </label>
    <?php
    endforeach; ?>
</div>
